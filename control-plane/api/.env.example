JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AGENT_GATEWAY_TOKEN=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
# Optional: extra CORS origin regex (localhost/127.0.0.1/private LAN, any port).
# Empty = default from core/config.py; disable with pattern (?!)
CORS_ORIGIN_REGEX=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Optional: creates the first administrator if this email does not exist.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-at-least-12-characters
