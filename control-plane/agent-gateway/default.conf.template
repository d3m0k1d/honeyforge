server {
    listen 8443 ssl;
    server_name _;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /etc/honeypotforge/mtls/server/server.crt;
    ssl_certificate_key /etc/honeypotforge/mtls/server/server.key;
    ssl_client_certificate /etc/honeypotforge/mtls/ca/ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 1;
    client_max_body_size 2m;

    location = /config {
        limit_except GET { deny all; }
        proxy_pass http://api:8000/agents/config;
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    # Browser-like aliases keep the agent channel from advertising its purpose.
    # Legacy explicit paths remain temporarily for deployed agents.
    location = /assets/manifest.json {
        limit_except GET { deny all; }
        proxy_pass http://api:8000/agents/config;
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    location = /events {
        limit_except POST { deny all; }
        proxy_pass http://api:8000/agents/events;
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    location = /assets/collect {
        limit_except POST { deny all; }
        proxy_pass http://api:8000/agents/events;
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    location = /sessions {
        limit_except POST { deny all; }
        proxy_pass http://api:8000/agents/sessions;
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    location = /assets/runtime {
        limit_except POST { deny all; }
        proxy_pass http://api:8000/agents/sessions;
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    location = /artifacts {
        limit_except POST { deny all; }
        client_max_body_size 11m;
        proxy_pass http://api:8000/agents/artifacts;
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    location = /assets/blob {
        limit_except POST { deny all; }
        client_max_body_size 11m;
        proxy_pass http://api:8000/agents/artifacts;
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    location = /honeytoken-triggers {
        limit_except POST { deny all; }
        proxy_pass http://api:8000/agents/honeytoken-triggers;
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    location = /assets/pixel {
        limit_except POST { deny all; }
        proxy_pass http://api:8000/agents/honeytoken-triggers;
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    location = /heartbeat {
        proxy_pass http://api:8000/agents/heartbeat;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    location = /assets/status {
        limit_except POST { deny all; }
        proxy_pass http://api:8000/agents/heartbeat;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    location /commands/ {
        proxy_pass http://api:8000/agents/commands/;
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    location /assets/tasks/ {
        proxy_pass http://api:8000/agents/commands/;
        proxy_set_header X-Agent-Gateway-Token "${AGENT_GATEWAY_TOKEN}";
        proxy_set_header X-Agent-Certificate-Verified $ssl_client_verify;
        proxy_set_header X-Agent-Certificate-Subject $ssl_client_s_dn;
    }

    location / {
        return 404;
    }
}

server {
    listen 8444 ssl;
    server_name _;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /etc/honeypotforge/mtls/server/server.crt;
    ssl_certificate_key /etc/honeypotforge/mtls/server/server.key;
    client_max_body_size 2m;

    location / {
        proxy_pass http://api:8000;
        proxy_read_timeout 75s;
        proxy_set_header X-Agent-Gateway-Token "";
        proxy_set_header X-Agent-Certificate-Verified "";
        proxy_set_header X-Agent-Certificate-Subject "";
    }
}
